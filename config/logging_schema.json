{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ts", "level", "service", "event", "correlation_id"],
  "properties": {
    "ts": {"type": "string"},
    "level": {"type": "string"},
    "service": {"type": "string"},
    "event": {"type": "string"},
    "correlation_id": {"type": "string"},
    "env": {"type": ["string", "null"]},
    "user_id_hash": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "feature": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "latency_ms": {"type": ["integer", "null"]},
    "tokens_in": {"type": ["integer", "null"]},
    "tokens_out": {"type": ["integer", "null"]},
    "cost_usd": {"type": ["number", "null"]},
    "quality_score": {"type": ["number", "null"]},
    "error_type": {"type": ["string", "null"]},
    "tool_name": {"type": ["string", "null"]},
    "payload": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "comment": "Request-scoped logs (service=='api') must carry the full enrichment context bound by P1's middleware/main.py, matching ENRICHMENT_FIELDS in scripts/validate_logs.py.",
      "if": {
        "properties": {"service": {"const": "api"}},
        "required": ["service"]
      },
      "then": {
        "required": ["user_id_hash", "session_id", "feature", "model", "env"]
      }
    }
  ]
}
